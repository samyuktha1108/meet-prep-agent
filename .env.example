# Copy this file to .env and fill in your own values.

# From https://ui.hindsight.vectorize.io after signup.
# Cloud base URL - check your Hindsight Cloud dashboard for the exact value,
# it is usually something like https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key-here

# Optional: change the Flask port
PORT=5050
